{
  "name": "resize-photos-internal-tool",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Zero-install browser tool that batch-resizes product photos to 3000x3000",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fixtures": "python3 scripts/make-fixtures.py"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
